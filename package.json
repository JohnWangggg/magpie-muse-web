{
  "name": "magpie-muse-web",
  "version": "0.4.0",
  "description": "Magpie provider plugin for muse.ai: sign in to each account in a browser window, use Muse Spark with tool calls in Codex, OpenCode and other agents, and see each account's weekly usage",
  "type": "module",
  "main": "./index.mjs",
  "exports": "./index.mjs",
  "files": [
    "index.mjs",
    "engine/",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test contract.test.mjs \"test/*.test.mjs\""
  },
  "keywords": [
    "magpie",
    "magpie-plugin",
    "opencode",
    "opencode-plugin",
    "muse",
    "muse-ai",
    "muse-spark"
  ],
  "author": "JohnWang (https://github.com/JohnWangggg)",
  "license": "MIT",
  "homepage": "https://github.com/JohnWangggg/magpie-muse-web#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JohnWangggg/magpie-muse-web.git"
  },
  "bugs": {
    "url": "https://github.com/JohnWangggg/magpie-muse-web/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "magpie": {
    "icon": "data:image/svg+xml;base64,",
    "maxConcurrency": 1
  }
}
